{
  "manifest_version": 3,
  "name": "Smart Autofill – Form Filler & Test Data for QA",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Form filler for QA and developers: fill any form with realistic fake test data in one click. Invalid and edge cases too. No sign-up.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the page"
    },
    "fill-field": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Fill the focused field"
    },
    "clear-form": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Clear the form"
    },
    "next-data-mode": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Switch to the next test data mode"
    },
    "undo-fill": {
      "description": "Undo the last fill"
    }
  },
  "action": {
    "default_title": "Smart Autofill – Click to autofill this form",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
