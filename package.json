{
  "name": "smart-autofill",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Chrome Manifest V3 extension for realistic QA form data.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --release && node scripts/package.mjs",
    "package:firefox": "node scripts/build.mjs --release --firefox && node scripts/package.mjs --firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:setup": "node scripts/e2e-setup.mjs",
    "test:e2e": "npm run build && cd e2e && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
